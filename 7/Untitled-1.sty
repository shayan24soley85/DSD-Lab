\section{تست مدار و \lr{Waveform}}
\subsection{کد \lr{Verilog} مربوط به \lr{Testbench}}
\begin{latin}
\begin{lstlisting}[language=Verilog, basicstyle=\tiny\ttfamily]
`timescale 1ns/1ns

module tb_uart_top;

    reg clk;
    reg rst;
    reg start;
    reg [6:0] data_in;
    
    wire [7:0] data_out;
    wire done;
    
    reg [7:0] expected_val;
    integer pass_count = 0;
    integer fail_count = 0;

    uart_top uut (
        .clk(clk),
        .rst(rst),
        .start(start),
        .data_in(data_in),
        .data_out(data_out),
        .done(done)
    );

    always #5 clk = ~clk;

    task test_scenario(input [6:0] test_data, input integer test_num);
        begin
            data_in = test_data;
            expected_val = {test_data, ^test_data}; 
            
            start = 1;
            #10 start = 0;
            
            wait(done == 1);
            #10; 
            
            if (data_out == expected_val) begin
                $display("Scenario %0d: Input = %b | Expected = %b | Received = %b -> [PASS]", test_num, data_in, expected_val, data_out);
                pass_count = pass_count + 1;
            end else begin
                $display("Scenario %0d: Input = %b | Expected = %b | Received = %b -> [FAIL]", test_num, data_in, expected_val, data_out);
                fail_count = fail_count + 1;
            end
            
            #50; 
        end
    endtask

    initial begin
        clk = 0;
        rst = 1;
        start = 0;
        data_in = 7'b0000000;

        #20 rst = 0;
        #10;
        
        $display("          UART Simulation Started...                     ");
        
        test_scenario(7'b0000000, 1);
        test_scenario(7'b1111111, 2);
        test_scenario(7'b1010101, 3);
        test_scenario(7'b0101010, 4);
        test_scenario(7'b1100110, 5);
        test_scenario(7'b0011001, 6);
        test_scenario(7'b0001000, 7);

        $display("Simulation Finished!");
        $stop;
    end
endmodule
\end{lstlisting}
\end{latin}
\vspace{2cm}

\subsection{خروجی‌ها، \lr{Waveform} و تحلیل آن‌ها}
پس از اجرای \lr{Testbench} در \lr{ModelSim}، لاگ‌های مربوط به ۷ سناریوی مختلف در ترمینال چاپ شد. در این کد از یک \lr{Task} استفاده شده است که متغیر \lr{expected\_val} را با وصل کزدن \lr{Parity Bit} به انتهای داده اصلی تولید می‌کند تا مقایسه خروجی به صورت خودکار انجام شود.

\vspace{0.75cm}
\begin{figure}[H]
    \centering
    \includegraphics[width=1\textwidth]{images/Screenshot 2026-08-31 220011.png}
    \caption{لاگ‌های چاپ شده در ترمینال شبیه‌ساز شامل وضعیت ۷ سناریوی تست}
    \label{fig:terminal_log}
\end{figure}
\vspace{0.75cm}

با بررسی دقیق \lr{Waveform} در بازه‌های زمانی مختلف، منطق عملکرد سیستم به شرح زیر تحلیل می‌شود:
\begin{itemize}
    \item \textbf{سناریوی ۱ (الگوی \lr{0000000}):} 
    در این حالت، دیتای ورودی شامل هیچ بیتی با ارزش یک نیست (زوج). بنابراین خروجی بلوک تولید \lr{Parity} صفر است و فریم هدف به صورت \lr{00000000} درمی‌آید. در \lr{Waveform} مشاهده می‌شود که پس از اتمام شیفت‌ها، سیگنال \lr{done} فعال شده و رجیستر خروجی آپدیت می‌شود.

    \item \textbf{سناریوی ۲ (الگوی \lr{1111111}):} 
    در اینجا تعداد یک‌ها فرد است (هفت عدد)، بنابراین \lr{Parity Bit} یک محاسبه شده و متغیر \lr{expected\_val} مقدار \lr{11111111} را به خود می‌گیرد. پورت \lr{data\_out} نیز دقیقاً روی همین الگو تثبیت می‌شود.

    \item \textbf{سناریوی ۳ (الگوی \lr{1010101}):} 
    این الگو دارای چهار بیت یک (زوج) است، پس \lr{Parity} برابر صفر شده و مقدار مورد انتظار \lr{10101010} خواهد بود. سیستم به درستی نوسانات خط را دنبال کرده و داده را واکشی می‌کند.

    \item \textbf{سناریوی ۴ (الگوی \lr{0101010}):} 
    برعکس حالت قبل، این الگو دارای سه بیت یک (فرد) است که منجر به تولید \lr{Parity} یک و خروجی \lr{01010101} می‌شود. \lr{State Machine} بدون از دست دادن هماهنگی، این فریم را نیز به درستی دریافت می‌کند.

    \item \textbf{سناریوی ۵ (الگوی \lr{1100110}):} 
    این الگو با چهار بیت یک، \lr{Parity} صفر تولید می‌کند و انتظار می‌رود خروجی \lr{11001100} باشد. پالس \lr{done} در زمان‌بندی دقیق و مشابه سناریوهای قبلی فعال می‌شود.

    \item \textbf{سناریوی ۶ (الگوی \lr{0011001}):} 
    با سه بیت یک در ورودی، \lr{Parity} یک محاسبه شده و داده \lr{00110011} روی پورت خروجی قرار می‌گیرد. متغیر \lr{pass\_count} با موفقیت به عدد ۶ می‌رسد.

    \item \textbf{سناریوی ۷ (الگوی \lr{0001000}):} 
    در نهایت، الگویی با تنها یک بیت یک (فرد) بررسی می‌شود که \lr{Parity} آن یک است (خروجی \lr{00010001}). فواصل زمانی پالس‌های \lr{start} تا فعال شدن سیگنال \lr{done} در این سناریو نیز کاملاً مشابه شش حالت قبل است که عملکرد یکنواخت و زمان‌بندی دقیق مدار را در تمامی فریم‌ها تایید می‌کند.
\end{itemize}

